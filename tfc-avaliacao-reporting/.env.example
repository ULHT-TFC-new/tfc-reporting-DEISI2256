# Copiar para .env e alterar os valores (o .env não vai para o repositório)

# Base de dados
POSTGRES_DB=tfc
POSTGRES_USER=tfc
POSTGRES_PASSWORD=mudar-esta-password

# Django
DJANGO_SECRET_KEY=mudar-esta-chave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Endereços do frontend autorizados a chamar a API (separados por vírgulas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
